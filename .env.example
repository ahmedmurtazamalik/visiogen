# Choose exactly one extraction provider: local or gemini.
VISIOGEN_PROVIDER=local

# OpenAI-compatible local Qwen endpoint.
VISIOGEN_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
VISIOGEN_LOCAL_MODEL=qwen3.5-9b

# Gemini is required only when VISIOGEN_PROVIDER=gemini.
VISIOGEN_GEMINI_MODEL=gemini-2.5-flash
VISIOGEN_GEMINI_API_KEY=

VISIOGEN_TIMEOUT_SECONDS=60
VISIOGEN_DEBUG=false
