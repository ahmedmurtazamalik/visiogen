digraph visiogen {
  graph [rankdir="LR", nodesep="1.2500", ranksep="1.5000"];
  node [fixedsize="true", shape="box"];
  "memory" [width="2.2000", height="1.1500", label="Memory"];
  "processor" [width="2.4000", height="0.9000", label="Processor"];
  "sensor" [width="1.4000", height="1.4000", label="Sensor"];
  "processor" -> "memory" [weight="3"];
  "sensor" -> "processor" [weight="3"];
}